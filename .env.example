# ===== Chạy trên máy chủ (docker compose) =====
# Không cần cấu hình database: compose.yaml dùng SQLite trong volume riêng `practice_data`,
# tách hoàn toàn khỏi CSDL của SaleCheckIn (không tạo role, không tạo database ở đó).

# Token để ghi đề qua API (POST/PUT/DELETE /api/exams, /api/exams/import) và tạo tài khoản đăng nhập.
# Để trống thì các API này bị tắt hẳn; đọc đề và làm bài vẫn dùng được.  openssl rand -hex 24
ADMIN_TOKEN=

# Chấm Writing bằng AI (trang /writing). Tự điền thẳng vào .env trên máy chủ, đừng gửi qua chat.
# Không đặt key thì vẫn tự chấm được.
ANTHROPIC_API_KEY=
# Mặc định: claude-sonnet-5-5
ANTHROPIC_MODEL=
# Giới hạn để không ai làm cạn hạn mức trả phí: mỗi tài khoản mỗi giờ, và cả hệ thống mỗi ngày.
AI_RATE_LIMIT_PER_HOUR=10
AI_RATE_LIMIT_PER_DAY=300

# Mạng Docker của SaleCheckIn mà container này đứng chung, chỉ để Caddy của SaleCheckIn định tuyến tới
# (xem compose.yaml). Để trống thì dùng mặc định salecheckin_default.
PRACTICE_NETWORK=

# Trần tài nguyên của container (máy chủ dùng chung).
APP_MEM_LIMIT=512m
APP_CPUS=1

# ===== Chạy trên máy cá nhân (npm run dev) =====
# Không đặt gì cả: ứng dụng tự tạo data/exams.db (SQLite) và tự nạp db/seed/*.json lần đầu.
DATABASE_FILE=
# Muốn thử bằng PostgreSQL bất kỳ (kể cả Neon) thay vì SQLite thì đặt DATABASE_URL — không bắt buộc.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== Chỉ giao diện, chạy ở Vercel =====
# Địa chỉ API trên máy chủ. Phải đặt LÚC DỰNG (Vercel > Settings > Environment Variables):
# mọi đường /api/* sẽ được chuyển tới đây, khoá AI và token quản trị không nằm ở Vercel.
# API_ORIGIN=https://api.ten-mien-cua-ban.com
