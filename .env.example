# ===== Chạy trên máy chủ (docker compose) =====
# PostgreSQL: dùng PostgreSQL của SaleCheckIn trên cùng máy chủ, bằng database và tài khoản RIÊNG
# (tạo một lần bằng deploy/provision-db.sql). Mật khẩu chỉ gồm chữ và số:  openssl rand -hex 24
PG_PASSWORD=
PG_USER=practice_app
PG_DATABASE=practice
PG_HOST=db
PG_NETWORK=salecheckin_default

# Token để ghi đề qua API (POST/PUT/DELETE /api/exams, /api/exams/import).
# Để trống thì các API ghi bị tắt hẳn; đọc đề và làm bài vẫn dùng được.  openssl rand -hex 24
ADMIN_TOKEN=

# Chấm Writing bằng AI (trang /writing). Tự điền thẳng vào .env trên máy chủ, đừng gửi qua chat.
# Không đặt key thì vẫn tự chấm được.
ANTHROPIC_API_KEY=
# Mặc định: claude-sonnet-5-5
ANTHROPIC_MODEL=
# Giới hạn để không ai làm cạn hạn mức trả phí: mỗi IP mỗi giờ, và cả hệ thống mỗi ngày.
AI_RATE_LIMIT_PER_HOUR=10
AI_RATE_LIMIT_PER_DAY=300

# Trần tài nguyên của container (máy chủ dùng chung).
APP_MEM_LIMIT=512m
APP_CPUS=1

# ===== Chạy trên máy cá nhân (npm run dev) =====
# Không đặt DATABASE_URL thì dùng SQLite một file, tự tạo và tự nạp db/seed/*.json lần đầu.
DATABASE_FILE=
# Đặt DATABASE_URL để dùng PostgreSQL bất kỳ (kể cả Neon). Trên máy chủ, compose.yaml tự ghép từ PG_*.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== Chỉ giao diện, chạy ở Vercel =====
# Địa chỉ API trên máy chủ. Phải đặt LÚC DỰNG (Vercel > Settings > Environment Variables):
# mọi đường /api/* sẽ được chuyển tới đây, khoá AI và token quản trị không nằm ở Vercel.
# API_ORIGIN=https://api.ten-mien-cua-ban.com
